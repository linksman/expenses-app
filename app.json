{
  "expo": {
    "name": "Vacation Expenses",
    "slug": "vacation-expenses",
    "version": "1.0.0",
    "icon": "./assets/icon-neutral.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.linksman.vacationexpenses",
      "adaptiveIcon": {
        "backgroundColor": "#18181B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/icon-neutral.png"
    },
    "plugins": [
      "expo-font",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/android-icon-foreground.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#18181B"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "f1e37fc9-c40d-4222-a4f1-20779c3f4d21"
      }
    },
    "owner": "linksman"
  }
}
